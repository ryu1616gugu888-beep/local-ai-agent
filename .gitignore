# --- 秘密情報 -----------------------------------------------------------
# config/ には Gemini APIキー・Notionトークン・Perplexityのセッションcookie・
# Gmail OAuthトークンが平文で入る。絶対にコミットしないこと。
# 構造の参照用には config/servers.example.json(値を伏せたもの)だけを例外的に含める。
config/*
!config/servers.example.json

# --- ランタイム生成物 ---------------------------------------------------
# 会話DB・各種ログ・スクリーンショット・生成画像/スライド・ブラウザプロファイル
data/

# --- Python -------------------------------------------------------------
venv/
__pycache__/
*.py[cod]

# --- macOS --------------------------------------------------------------
.DS_Store

# --- ランタイムロック -----------------------------------------------------
.claude/scheduled_tasks.lock

# --- 手動バックアップ ---------------------------------------------------
# git導入以前の名残。以後はgit履歴で巻き戻すのでファイルとしては残さない。
*.bak
*.backup
